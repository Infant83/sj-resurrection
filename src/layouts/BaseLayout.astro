---
import BoardNav from '../components/BoardNav.astro';
import '../styles/global.css';
import { withBase } from '../lib/archive';

interface Props {
  title?: string;
  description?: string;
  activeBoard?: string;
}

const {
  title = 'Sunjin UpRising',
  description = '선진의 회복 과정과 가족의 기록을 보존하는 공개 미리보기 아카이브',
  activeBoard,
} = Astro.props;
const documentTitle = title === 'Sunjin UpRising' ? title : `${title} · Sunjin UpRising`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#103D46" />
    <meta name="application-name" content="Sunjin UpRising" />
    <meta name="apple-mobile-web-app-title" content="Sunjin UpRising" />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase('icons/sunjin-healing-watercolor-20261022-512.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('icons/sunjin-healing-watercolor-20261022-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('icons/sunjin-healing-watercolor-20261022-180.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase()} aria-label="Sunjin UpRising 홈">
          <span
            class="brand-mark"
            aria-hidden="true"
            title="아스클레피오스의 지팡이 — 치유와 회복의 표식"
          ><img src={withBase('icons/sunjin-healing-watercolor-20261022-192.png')} width="40" height="40" alt="" decoding="async" /></span>
          <span>
            <strong>Sunjin <span class="uprising-word">Up<span class="uprising-r">R</span>ising</span></strong>
            <small>선진 <span class="uprising-word">Up<span class="uprising-r">R</span>ising</span> 프로젝트</small>
          </span>
        </a>
        <span class="privacy-chip preview-chip" title="현재 누구나 접근할 수 있는 공개 미리보기입니다">
          <span aria-hidden="true">●</span> Public preview
        </span>
      </div>
      <BoardNav activeBoard={activeBoard} />
    </header>

    <main id="main-content" class="shell main-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>가족이 당시 관찰하고 전달받은 내용과 GPT 답변을 보존한 개인 기록입니다.</p>
        <a href={withBase('about/')}>기록 원칙과 주의사항</a>
      </div>
    </footer>
  </body>
</html>
