---
import { safeMarkdownToHtml, safePlainTextToHtml } from '../lib/safe-text';
import { formatKoreanStamp } from '../lib/archive';

interface Props {
  message: any;
  isLast?: boolean;
}

const { message, isLast = false } = Astro.props;
const isUser = message.role === 'user';
const primaryText = isUser ? (message.corrected ?? message.original) : message.text;
const showsCorrected = isUser && Boolean(message.corrected);
const isVoiceTranscript = message.sourceKind === 'voice-transcript';
const isEmbeddedReport = message.sourceKind === 'embedded-app-report';
const fidelityLabels: Record<string, string> = {
  exact: '원문 확인',
  'typo-corrected': '오탈자 교정본',
  'pending-original': '원문 확인 필요',
};
const userFidelityLabel = isUser ? (fidelityLabels[message.fidelity] ?? '원문 확인 필요') : '';
const userLabel = isVoiceTranscript ? '보호자 음성 전사' : '보호자 기록';
const replyLabel = isEmbeddedReport
  ? 'GPT 심층 리서치 보고서 원문'
  : isVoiceTranscript
    ? 'GPT 음성 답변 전사'
    : message.channel === 'commentary'
      ? 'GPT 중간 답변 원문'
      : 'GPT 답변 원문';
---

<section class:list={['conversation-message', isUser ? 'user-message' : 'assistant-message']}>
  <div class:list={['thread-post', isUser ? 'user-post' : 'assistant-post']}>
    <div class="thread-rail" aria-hidden="true">
      <span class:list={['avatar', isUser ? 'avatar-user' : 'avatar-gpt']}>{isUser ? '기록' : 'GPT'}</span>
      {!isLast && <span class="thread-line"></span>}
    </div>

    {
      isUser ? (
        <div class="thread-content">
          <div class="thread-label-row">
            <strong>{userLabel}</strong>
            <time datetime={message.recordedAt.start}>{formatKoreanStamp(message.recordedAt)}</time>
            <span class="fidelity-label">{userFidelityLabel}</span>
          </div>
          <div class="message-text message-text-plain" set:html={safePlainTextToHtml(primaryText)} />
          {showsCorrected && (
            <details class="original-toggle">
              <summary>입력 당시 원문 보기</summary>
              <div class="message-text message-text-plain original-text" set:html={safePlainTextToHtml(message.original)} />
            </details>
          )}
        </div>
      ) : (
        <details class="thread-content reply-details">
          <summary>
            <span class="reply-label">
              <strong>{replyLabel}</strong>
              <time datetime={message.recordedAt.start}>{formatKoreanStamp(message.recordedAt)}</time>
            </span>
            <span class="reply-action">전체 보기</span>
          </summary>
          <div class="reply-body">
            <div class="message-text" set:html={safeMarkdownToHtml(primaryText)} />
            {message.references.length > 0 && (
              <section class="reply-references" aria-label="당시 답변에 연결된 참고 링크">
                <strong>당시 답변에 연결된 참고 링크</strong>
                <ul>
                  {message.references.map((reference: any) => (
                    <li>
                      <a href={reference.url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">
                        {reference.title}
                      </a>
                      {reference.attribution && <span>{reference.attribution}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )}
            <p class="reply-provenance">{message.modelLabel} · 당시 공개 답변 원문</p>
          </div>
        </details>
      )
    }
  </div>
</section>
