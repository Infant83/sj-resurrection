---
import { safeTextToHtml } from '../lib/safe-text';

interface Props {
  exchange: any;
  index: number;
}

const { exchange, index } = Astro.props;
const user = exchange.user;
const primaryText = user.corrected ?? user.original;
const showsCorrected = Boolean(user.corrected);
const assistant = exchange.assistant;
const replyPreview = assistant?.text.replace(/\s+/g, ' ').trim().slice(0, 110);
const exchangeLabel = index > 0 ? `이어진 기록 ${index + 1}` : '당시 기록';
const fidelityLabels: Record<string, string> = {
  exact: '원문 확인',
  'typo-corrected': '오탈자 교정본',
  'summary-reconstruction': '대화 요약 복원본',
  'pending-original': '원문 확인 필요',
};
const userFidelityLabel = fidelityLabels[user.fidelity] ?? '원문 확인 필요';
const assistantFidelityLabel = assistant?.fidelity === 'exact'
  ? '당시 답변 원문'
  : assistant?.fidelity === 'typo-corrected'
    ? '당시 답변 교정본'
    : assistant?.fidelity === 'summary-reconstruction'
      ? '당시 답변 요약 복원본'
      : '답변 원문 확인 필요';
---

<section class="conversation-exchange" aria-label={`${exchangeLabel}과 GPT 답변`}>
  <div class="thread-post user-post">
    <div class="thread-rail" aria-hidden="true">
      <span class="avatar avatar-user">기록</span>
      <span class="thread-line"></span>
    </div>
    <div class="thread-content">
      <div class="thread-label-row">
        <strong>{exchangeLabel}</strong>
        <span class="fidelity-label">{userFidelityLabel}</span>
      </div>
      <div class="message-text" set:html={safeTextToHtml(primaryText)} />
      {
        showsCorrected && (
          <details class="original-toggle">
            <summary>입력 당시 원문 보기</summary>
            <div class="message-text original-text" set:html={safeTextToHtml(user.original)} />
          </details>
        )
      }
    </div>
  </div>

  {
    assistant ? (
      <div class="thread-post assistant-post">
        <div class="thread-rail" aria-hidden="true">
          <span class="avatar avatar-gpt">GPT</span>
        </div>
        <details class="thread-content reply-details">
          <summary>
            <span class="reply-summary-copy">
              <strong>GPT Reply</strong>
              <span class="reply-preview">{replyPreview}{assistant.text.length > 110 ? '…' : ''}</span>
            </span>
            <span class="reply-action">답변 보기</span>
          </summary>
          <div class="reply-body">
            <div class="message-text" set:html={safeTextToHtml(assistant.text)} />
            <p class="reply-provenance">{assistant.modelLabel} · {assistantFidelityLabel}</p>
          </div>
        </details>
      </div>
    ) : (
      <div class="thread-post assistant-post pending-reply">
        <div class="thread-rail" aria-hidden="true">
          <span class="avatar avatar-gpt">GPT</span>
        </div>
        <div class="thread-content">
          <p>당시 GPT 답변 원문을 수집하는 중입니다.</p>
        </div>
      </div>
    )
  }
</section>
