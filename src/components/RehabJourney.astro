---
import type { CollectionEntry } from 'astro:content';
import hospitalRecords from '../data/rehab-hospitals.json';
import { rehabHospitals, rehabPhases } from '../data/rehab';
import { withBase, sortPosts } from '../lib/archive';

interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
const hospitalName = (id: string) => rehabHospitals.find(h => h.id === id)?.label ?? id;
const dateLabel = (date: string) => {
  const [y, m, d] = date.split('-').map(Number);
  return `${y}년 ${m}월 ${d}일`;
};
const inpatientPosts = sortPosts(posts.filter(p => p.data.rehab?.phases.includes('inpatient-rehab')));
---

<section class="rehab-journey" aria-label="재활 진료와 치료 기록 안내">
  <nav class="rehab-jump-links" aria-label="재활 기록 바로가기">
    <a href="#hospital-appointments">병원별 예약</a>
    <a href="#rehab-records">진료 대화</a>
    <a href="#inpatient-rehab">입원 재활</a>
  </nav>

  <section id="hospital-appointments" class="rehab-appointments" aria-labelledby="appointments-title">
    <div class="rehab-section-heading">
      <div>
        <p class="rehab-kicker">외래에서 시작하는 재활</p>
        <h2 id="appointments-title">병원별 예약과 기록</h2>
      </div>
      <span class="rehab-as-of">{dateLabel(hospitalRecords.reviewedAsOf)} 확인</span>
    </div>
    <p class="rehab-basis">{hospitalRecords.basis}입니다. 예약 이후의 진료 결과와 입원 결정은 확인되는 대화에 이어 기록합니다.</p>
    <div class="rehab-hospital-grid">
      {hospitalRecords.hospitals.map(h => {
        const count = posts.filter(p => p.data.rehab?.hospitalIds.includes(h.id as typeof rehabHospitals[number]['id'])).length;
        return (
          <article class="rehab-hospital-card" data-hospital-card={h.id}>
            <div class="rehab-hospital-top"><h3>{hospitalName(h.id)}</h3><span>외래 예약 기록</span></div>
            <p class="rehab-clinician">{h.clinician}</p>
            <p class="rehab-appointment-date"><time datetime={h.appointment.date}>{dateLabel(h.appointment.date)}</time><strong>{h.appointment.time ?? '시각 미확인'}</strong></p>
            <p class="rehab-hospital-note">{h.note}</p>
            <div class="rehab-source-links" aria-label={`${hospitalName(h.id)} 예약의 근거 기록`}>
              {h.sources.map(s => <a href={withBase(`post/${s.postId}/#${s.messageId}`)}>{s.label} ↗</a>)}
            </div>
            <a class="rehab-hospital-records" href={withBase(`board/rehab-care/?hospital=${h.id}#rehab-records`)}>
              {hospitalName(h.id)} 진료 대화 <span>{count}개</span>
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <section id="inpatient-rehab" class="rehab-inpatient" aria-labelledby="inpatient-title">
    <div><p class="rehab-kicker">진료 다음의 기록</p><h2 id="inpatient-title">입원 재활</h2></div>
    {inpatientPosts.length ? (
      <ul>{inpatientPosts.map(p => <li><a href={withBase(`post/${p.id}/`)}>{p.data.title}</a></li>)}</ul>
    ) : (
      <div>
        <p><strong>아직 입원 재활 기록이 없습니다.</strong></p>
        <p>입원이 결정되면 입원일과 초기 평가, 치료 목표, 인지·언어·운동·연하 치료 경과, 재평가 내용을 이곳에 이어갑니다.</p>
      </div>
    )}
  </section>

  <div class="rehab-support-links" aria-label="기존 재활 자료">
    <a href={withBase('board/rehabilitation/')}><strong>재활 준비 자료 ↗</strong><span>병원 검토·전원 준비와 병상 활동</span></a>
    <a href={withBase('activities/')}><strong>인지 활동 앱 ↗</strong><span>로그인 없이 바로 시작하는 짧은 활동</span></a>
  </div>

  <section id="rehab-records" class="rehab-record-heading" aria-labelledby="rehab-records-title">
    <p class="rehab-kicker">외래 준비 · 진료 · 치료 경과</p>
    <h2 id="rehab-records-title">재활 진료 대화</h2>
    <p>대화를 입력한 날짜 순서로 보존합니다. 진료 전 준비, 실제 진료 결과와 입원 중 기록은 각각 구분해 찾을 수 있습니다.</p>
    <div class="rehab-phase-links" aria-label="단계별 기록 수">
      {rehabPhases.map(phase => (
        <a href={withBase(`board/rehab-care/?phase=${phase.id}#rehab-records`)}>{phase.label}<span>{posts.filter(p => p.data.rehab?.phases.includes(phase.id)).length}</span></a>
      ))}
    </div>
  </section>
</section>

<style>
  .rehab-journey { margin-bottom: 24px; }
  .rehab-jump-links { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 30px; }
  .rehab-jump-links a { padding: 8px 15px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); text-decoration: none; font-size: .88rem; min-height: 44px; }
  .rehab-appointments, .rehab-inpatient, .rehab-record-heading { scroll-margin-top: 160px; }
  .rehab-section-heading { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  h2 { margin: 0; font-size: 1.4rem; line-height: 1.35; letter-spacing: -.03em; }
  .rehab-kicker { margin: 0 0 7px; color: #2e675e; font-size: .76rem; font-weight: 700; letter-spacing: .05em; }
  .rehab-as-of { font-size: .76rem; color: var(--ink-soft); }
  .rehab-basis { font-size: .88rem; color: var(--ink-soft); margin: 13px 0 22px; max-width: 670px; }
  .rehab-hospital-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .rehab-hospital-card { padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); display: flex; flex-direction: column; }
  .rehab-hospital-card:first-child { border-top: 4px solid #2e675e; padding-top: 19px; }
  .rehab-hospital-top { display: flex; align-items: start; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  h3 { margin: 0; font-size: 1.13rem; letter-spacing: -.04em; }
  .rehab-hospital-top > span { font-size: .68rem; background: #edf2ec; color: #34594d; padding: 3px 7px; border-radius: 5px; }
  .rehab-clinician { margin: 6px 0 20px; font-size: .85rem; color: var(--ink-soft); }
  .rehab-appointment-date { margin: 0 0 15px; font-size: 1.02rem; line-height: 1.5; }
  .rehab-appointment-date strong { display: block; font-size: 1.5rem; font-weight: 650; color: #2e675e; letter-spacing: -.03em; }
  .rehab-hospital-note { margin: 0 0 16px; font-size: .87rem; }
  .rehab-source-links { display: grid; gap: 8px; font-size: .79rem; color: var(--ink-soft); margin-top: auto; padding-bottom: 20px; }
  .rehab-source-links a { padding-block: 5px; }
  .rehab-hospital-records { border-top: 1px solid var(--line); padding-top: 13px; display: flex; gap: 8px; justify-content: space-between; align-items: center; text-decoration: none; font-size: .85rem; font-weight: 600; min-height: 44px; }
  .rehab-hospital-records span { font-size: .76rem; white-space: nowrap; color: #2e675e; }
  .rehab-inpatient { display: grid; grid-template-columns: 1fr 2.5fr; gap: 22px; border: 1px solid #cadcd4; background: #eaf2ec; border-radius: 18px; padding: 24px; margin-top: 24px; }
  .rehab-inpatient p { margin: 0; font-size: .86rem; }
  .rehab-inpatient p + p { margin-top: 6px; color: var(--ink-soft); }
  .rehab-support-links { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 18px 0 38px; }
  .rehab-support-links a { padding: 14px 0; text-decoration: none; border-bottom: 1px solid var(--line-strong); }
  .rehab-support-links strong { display: block; font-size: .87rem; }
  .rehab-support-links span { display: block; margin-top: 4px; font-size: .77rem; color: var(--ink-soft); }
  .rehab-record-heading > p:not(.rehab-kicker) { font-size: .87rem; color: var(--ink-soft); }
  .rehab-phase-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .rehab-phase-links a { display: inline-flex; gap: 10px; align-items: center; padding: 8px 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; font-size: .78rem; text-decoration: none; min-height: 44px; }
  .rehab-phase-links span { color: #2e675e; font-weight: 700; }
  @media (max-width: 560px) {
    .rehab-hospital-grid { grid-template-columns: 1fr; }
    .rehab-inpatient { grid-template-columns: 1fr; gap: 14px; }
    .rehab-support-links { grid-template-columns: 1fr; gap: 0; }
  }
</style>
