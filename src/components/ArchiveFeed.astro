---
import type { CollectionEntry } from 'astro:content';
import { sortPosts } from '../lib/archive';
import PostCard from './PostCard.astro';
import { rehabHospitals, rehabPhases } from '../data/rehab';

interface Props {
  posts: CollectionEntry<'posts'>[];
  boardLabel?: string;
  rehabFilters?: boolean;
}

const { posts, boardLabel = '전체 기록', rehabFilters = false } = Astro.props;
const sortedPosts = sortPosts(posts);
const months = [...new Set(sortedPosts.map((post) => post.data.recordedAt.start.slice(0, 7)))].filter((month) => /^\d{4}-\d{2}$/.test(month));
---

<section class="archive-feed" data-archive-feed>
  {rehabFilters && (
    <div class="rehab-feed-filters" aria-label="재활 기록 분류">
      <label>병원
        <select data-hospital-filter>
          <option value="all">모든 병원</option>
          {rehabHospitals.map(h => <option value={h.id}>{h.label}</option>)}
        </select>
      </label>
      <label>기록 단계
        <select data-rehab-phase-filter>
          <option value="all">모든 단계</option>
          {rehabPhases.map(p => <option value={p.id}>{p.label}</option>)}
        </select>
      </label>
      <button type="button" data-feed-reset>전체 기록 보기</button>
    </div>
  )}
  <div class="feed-toolbar" aria-label={`${boardLabel} 찾기와 정렬`}>
    <label class="search-field">
      <span class="sr-only">기록 검색</span>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
      <input type="search" placeholder="날짜, 치료, 편지, 재활 검색" data-feed-search />
    </label>
    <label class="month-field">
      <span class="sr-only">월 선택</span>
      <select data-month-filter>
        <option value="all">모든 날짜</option>
        {months.map((month) => <option value={month}>{month.replace('-', '년 ')}월</option>)}
      </select>
    </label>
    <div class="sort-control" role="group" aria-label="기록 정렬">
      <button class="active" type="button" data-sort="desc" aria-pressed="true">최신순</button>
      <button type="button" data-sort="asc" aria-pressed="false">처음부터</button>
    </div>
  </div>

  <p class="feed-result-status" aria-live="polite" data-result-status></p>

  <section class="search-results" data-search-results hidden aria-label="검색 결과 목록">
    <h2>검색 결과 <span data-search-count aria-live="polite"></span></h2>
    <p>결과를 누르면 강조된 위치로 이동합니다. 접힌 답변도 함께 검색합니다.</p>
    <ol data-search-result-list></ol>
    <button class="search-results-more" type="button" data-results-more hidden>검색 결과 더 보기</button>
  </section>

  <div class="feed-list" data-feed-list>
    {sortedPosts.map((post) => <PostCard post={post} />)}
  </div>

  <div class="feed-empty" data-feed-empty hidden>
    <strong>조건에 맞는 기록이 없습니다.</strong>
    <p>검색어 또는 날짜 조건을 바꾸어 보세요.</p>
  </div>

  <button class="load-more" type="button" data-load-more>
    이전 기록 더 보기
    <span aria-hidden="true">↓</span>
  </button>
</section>

<script>
  import { initializeArchiveFeed } from '../lib/archive-feed';
  const feed = document.querySelector<HTMLElement>('[data-archive-feed]');
  if (feed) initializeArchiveFeed(feed);
</script>
