---
import { getCollection } from 'astro:content';
import ArchiveFeed from '../components/ArchiveFeed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { assertArchiveIntegrity, isPublicPost, withBase } from '../lib/archive';

const allPosts = await getCollection('posts');
assertArchiveIntegrity(allPosts);
const posts = allPosts.filter(({ data }) => isPublicPost(data));
---

<BaseLayout>
  <section class="page-intro">
    <div>
      <p class="eyebrow">가족의 시간과 회복의 기록</p>
      <h1>Sunjin <span class="uprising-word">Up<span class="uprising-r">R</span>ising</span></h1>
      <p>
        날짜별 보호자 프롬프트와 당시 GPT 답변 전문을 원 대화 그대로 보존합니다. 화면에는 명백한
        오탈자와 띄어쓰기만 교정하고, 입력 당시 원문도 함께 남깁니다.
      </p>
    </div>
    <div class="archive-note">
      <strong>공개 미리보기</strong>
      <span>요약 복원본은 모두 내렸습니다. 원문과 당시 GPT 답변 전문이 함께 확인된 기록만 게시합니다.</span>
    </div>
  </section>

  <a class="rehab-home-link" href={withBase('board/rehab-care/')}>
    <span><strong>선진의 재활 기록</strong><small>병원별 외래 준비부터 진료·입원 재활까지 이어갑니다.</small></span>
    <span aria-hidden="true">↗</span>
  </a>

  {
    posts.length > 0 ? (
      <ArchiveFeed posts={posts} />
    ) : (
      <section class="board-empty-state">
        <span aria-hidden="true">○</span>
        <h2>원문 이관을 준비하고 있습니다.</h2>
        <p>원 대화에서 보호자 프롬프트와 GPT 답변 전문이 함께 확인된 순서대로 날짜별 기록을 게시합니다.</p>
      </section>
    )
  }
</BaseLayout>

<style>
  .rehab-home-link { display: flex; align-items: center; justify-content: space-between; gap: 18px; border: 1px solid #cadcd4; border-radius: 14px; padding: 18px 22px; margin: 0 0 25px; background: #eaf2ec; text-decoration: none; }
  .rehab-home-link strong { display: block; color: #2e675e; font-size: .98rem; }
  .rehab-home-link small { display: block; margin-top: 4px; color: var(--ink-soft); font-size: .83rem; }
</style>
