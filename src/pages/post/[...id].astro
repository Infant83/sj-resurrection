---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import { boardMap } from '../../data/boards';
import { assertArchiveIntegrity, isPublicPost, withBase } from '../../lib/archive';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  assertArchiveIntegrity(allPosts);
  const posts = allPosts.filter(({ data }) => isPublicPost(data));
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const board = boardMap[post.data.board];
const isEmbeddedReportOnly = post.data.messages.every(
  (message) => message.role === 'user' && message.sourceKind === 'embedded-app-report',
);
const description = isEmbeddedReportOnly
  ? `${post.data.title} — 보호자가 제공한 병원 통화 자동 요약 전문`
  : `${post.data.title} — 보호자 원문과 당시 GPT 답변 전문`;
---

<BaseLayout title={post.data.title} description={description} activeBoard={post.data.board}>
  <nav class="breadcrumb" aria-label="현재 위치">
    <a href={withBase()}>전체 기록</a>
    <span aria-hidden="true">/</span>
    <a href={withBase(`board/${post.data.board}/`)}>{board.label}</a>
  </nav>

  <PostCard post={post} detailed />

  <div class="detail-return">
    <a href={withBase(`board/${post.data.board}/`)}>← {board.label} 게시판으로</a>
  </div>
</BaseLayout>
